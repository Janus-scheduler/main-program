{
  "name": "@janus-scheduler/app",
  "version": "2.1.0",
  "description": "Batteries-included Janus Scheduler — a single <janus-app> element that wires the topbar, all five views, the event editor and undo to a SchedulerManager for you.",
  "keywords": [
    "scheduler",
    "calendar",
    "timeline",
    "events",
    "scheduling",
    "web-components",
    "lit",
    "all-in-one"
  ],
  "license": "ISC",
  "author": "janus-scheduler-app",
  "homepage": "https://github.com/Janus-scheduler/main-program#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Janus-scheduler/main-program.git",
    "directory": "packages/app"
  },
  "bugs": {
    "url": "https://github.com/Janus-scheduler/main-program/issues"
  },
  "type": "module",
  "sideEffects": true,
  "main": "./dist/index.cjs",
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.es.js",
      "require": "./dist/react.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "dev": "vite build --watch",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "@janus-scheduler/core": "^2.1.0",
    "@janus-scheduler/ui": "^2.1.0",
    "@lit/react": "^1.0.4",
    "lit": "^3.1.2"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
