                <mxCell id="re4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" parent="r1" source="rvv" target="rscore" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="re5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" parent="r1" source="rscore" target="rvote" edge="1">
