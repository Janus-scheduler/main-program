                <mxCell id="mm1" value="artifacts/   —  5.76 MB, shipped as asset files&#xa;vectors.bin · vocab.json · prototypes.json&#xa;(never base64-inlined)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="mmain" vertex="1">
                    <mxGeometry x="25" y="50" width="420" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="mm2" value="src/  —  ported from bin/index.js&#xa;&#xa;constants.ts   ◄ SINGLE SOURCE OF TRUTH&#xa;types.ts · normalize.ts · wordpiece.ts&#xa;embed.ts · preprocess.ts · classify.ts&#xa;gates.ts · artifacts.ts" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" parent="mmain" vertex="1">
                    <mxGeometry x="25" y="140" width="420" height="120" as="geometry"/>
