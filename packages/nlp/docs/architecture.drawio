<mxfile host="65bd71144e">
    <diagram id="page-build" name="1 - Build Pipeline (offline)">
        <mxGraphModel dx="209" dy="563" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1400" math="0" shadow="0">
            <root>
                <mxCell id="b0"/>
                <mxCell id="b1" parent="b0"/>
                <mxCell id="btitle" value="BUILD PIPELINE — runs offline in THIS repo, never at runtime&#xa;python scripts/build_embeddings.py" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;whiteSpace=wrap;" parent="b1" vertex="1">
                    <mxGeometry x="80" y="20" width="1000" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="bn1" value="corpus/intents.yaml&#xa;&#xa;222 labelled examples&#xa;add 45 · del 20 · mod 39&#xa;get 43 · none 75" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;" parent="b1" vertex="1">
                    <mxGeometry x="120" y="110" width="240" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="bn2" value="model2vec&#xa;minishlab/potion-base-8M&#xa;&#xa;FROZEN token→vector table&#xa;29,528 tokens × 256 dims&#xa;apply_zipf: true&#xa;NEVER trained or fine-tuned" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;" parent="b1" vertex="1">
                    <mxGeometry x="480" y="110" width="260" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="bn3" value="select_vocab()&#xa;&#xa;keep: [PAD][UNK][CLS][SEP][MASK]&#xa;+ ALL ## continuation tokens&#xa;+ ALL single-char tokens&#xa;+ top 6,500 by English rank&#xa;+ every token in the corpus&#xa;+ DOMAIN_RESOURCE_TERMS (20)&#xa;&#xa;29,528 → 11,949 tokens" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;" parent="b1" vertex="1">
                    <mxGeometry x="280" y="270" width="300" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="bn4" value="int8 quantize&#xa;per-row scale = max(abs(row)) / 127" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;" parent="b1" vertex="1">
                    <mxGeometry x="280" y="470" width="300" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="bn5" value="compute_weights()  —  Zipf / SIF&#xa;inv_rank = 1 / arange(2, n+2)&#xa;proba = inv_rank / sum(inv_rank)&#xa;w = 1e-4 / (1e-4 + proba)&#xa;&#xa;mirrors model2vec distillation — DO NOT CHANGE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;" parent="b1" vertex="1">
                    <mxGeometry x="280" y="580" width="300" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="bn6" value="build_prototypes()&#xa;&#xa;for each of the 222 corpus examples:&#xa;   vec_full = embed( strip_slots(text) )&#xa;   vec_verb = embed( head_verb_phrase_lexicon(text) )&#xa;&#xa;re-embedded through the PRUNED pipeline,&#xa;not model.encode() — so prototypes and&#xa;runtime queries share one vector space" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;" parent="b1" vertex="1">
                    <mxGeometry x="240" y="740" width="380" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="bn7" value="build_parity_fixtures()&#xa;&#xa;120 adversarial inputs: caps, w/, emoji,&#xa;accents, empty string, 200-char, punctuation,&#xa;one per contraction rule&#xa;&#xa;records BOTH views per fixture" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;" parent="b1" vertex="1">
                    <mxGeometry x="240" y="940" width="380" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="bart" value="ARTIFACTS  (the only runtime inputs)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;startSize=30;fontStyle=1;" parent="b1" vertex="1">
                    <mxGeometry x="720" y="270" width="330" height="790" as="geometry"/>
                </mxCell>
                <mxCell id="ba1" value="vectors.bin&#xa;2.92 MB&#xa;int8, 11,949 × 256&#xa;→ Int8Array" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;" parent="bart" vertex="1">
                    <mxGeometry x="30" y="50" width="270" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="ba2" value="vocab.json&#xa;476 KB&#xa;tokens / scales / weights (11,949 each)&#xa;dim=256 · unkId=1 · pooling=zipf&#xa;sifCoefficient=1e-4" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;" parent="bart" vertex="1">
                    <mxGeometry x="30" y="160" width="270" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="ba3" value="prototypes.json&#xa;2.37 MB&#xa;222 × { intent, text,&#xa;vec_full[256], vec_verb[256] }&#xa;&#xa;text field = only 9 KB — keep it" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;" parent="bart" vertex="1">
                    <mxGeometry x="30" y="480" width="270" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="ba4" value="parity.json&#xa;1.3 MB · 120 fixtures&#xa;&#xa;CI ONLY — not shipped&#xa;covers normalize→wordpiece→embed&#xa;does NOT cover scoring or gates" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;dashed=1;" parent="bart" vertex="1">
                    <mxGeometry x="30" y="660" width="270" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="bnote" value="⚠ SHIP = vectors.bin + vocab.json + prototypes.json = 5.76 MB&#xa;No Python, no ONNX, no ML dependency travels to runtime." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=center;fontStyle=1;" parent="b1" vertex="1">
                    <mxGeometry x="120" y="1110" width="930" height="60" as="geometry"/>
