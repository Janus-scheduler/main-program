    <diagram id="page-runtime" name="2 - Runtime Pipeline (frozen)">
        <mxGraphModel dx="542" dy="563" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1600" math="0" shadow="0">
            <root>
                <mxCell id="r0"/>
                <mxCell id="r1" parent="r0"/>
                <mxCell id="rtitle" value="RUNTIME PIPELINE — frozen at Phase 1.7 Task 7&#xa;spec: packages/nlp/docs/ALGORITHM.md   ·   reference impl: packages/nlp/bin/index.js" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;whiteSpace=wrap;" parent="r1" vertex="1">
                    <mxGeometry x="60" y="20" width="1050" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="rin" value="RAW INPUT TEXT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=14;" parent="r1" vertex="1">
                    <mxGeometry x="450" y="100" width="260" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="rviews" value="TWO VIEWS — built in parallel, identical transforms to build time" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;startSize=30;fontStyle=1;" parent="r1" vertex="1">
                    <mxGeometry x="120" y="200" width="920" height="420" as="geometry"/>
                </mxCell>
                <mxCell id="rv1" value="strip_slots(text)&#xa;&#xa;remove times/dates (TIME_PATTERNS)&#xa;+ RESOURCE_NAMES (29)&#xa;+ PARTICIPANT_NAMES (23)&#xa;consuming a leading prep/determiner&#xa;as part of the same match" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="rviews" vertex="1">
                    <mxGeometry x="40" y="50" width="380" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="rv2" value="head_verb_phrase_lexicon(text)&#xa;&#xa;strip LEADING_WRAPPERS (can you / i need / …)&#xa;then longest-match ^phrase from INTENT_VERBS&#xa;fallback: first \w+ token&#xa;&#xa;deterministic — replaced spaCy (Task 1)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="rviews" vertex="1">
                    <mxGeometry x="500" y="50" width="380" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="rv3" value="normalize()&#xa;lowercase → w/ → contractions →&#xa;apostrophe-less contractions →&#xa;strip punct → collapse ws" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="rviews" vertex="1">
                    <mxGeometry x="40" y="190" width="380" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="rv4" value="normalize()&#xa;(identical function)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="rviews" vertex="1">
                    <mxGeometry x="500" y="190" width="380" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="rv5" value="wordpiece() → embed()&#xa;greedy longest-match · dequantize&#xa;· Zipf-weighted mean · L2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="rviews" vertex="1">
                    <mxGeometry x="40" y="290" width="380" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="rv6" value="wordpiece() → embed()&#xa;(identical functions)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="rviews" vertex="1">
                    <mxGeometry x="500" y="290" width="380" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="rvf" value="vec_full" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" parent="r1" vertex="1">
                    <mxGeometry x="230" y="650" width="200" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="rvv" value="vec_verb" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" parent="r1" vertex="1">
                    <mxGeometry x="690" y="650" width="200" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="rscore" value="DUAL-VECTOR kNN  vs  222 prototypes&#xa;&#xa;sim = α · cos(q_full, p_full)  +  β · cos(q_verb, p_verb)&#xa;&#xa;α=0.2  β=0.8   for add / delete / modify / get_details&#xa;α=1.0  β=0.0   for  none    ◄── deliberate asymmetry (Task 4.5)&#xa;&#xa;none is OBJECT-carried; event intents are VERB-carried.&#xa;One blend cannot serve both." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=0;" parent="r1" vertex="1">
                    <mxGeometry x="290" y="730" width="540" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="rvote" value="VOTE — max similarity per intent over top-5 (NOT sum)&#xa;&#xa;confidence = winning intent score&#xa;margin     = confidence − best OTHER intent&#xa;             ◄── skips  none  entirely, even when none wins" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="r1" vertex="1">
                    <mxGeometry x="290" y="920" width="540" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="rgates" value="GATE LAYER — first match wins   (reads RAW pre-strip text)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;startSize=30;fontStyle=1;" parent="r1" vertex="1">
                    <mxGeometry x="180" y="1070" width="760" height="330" as="geometry"/>
                </mxCell>
                <mxCell id="rg0" value="negation?  →  CLARIFY          (checked FIRST — Zipf suppresses  not )" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=left;spacingLeft=10;" parent="rgates" vertex="1">
                    <mxGeometry x="20" y="40" width="720" height="34" as="geometry"/>
                </mxCell>
                <mxCell id="rg1" value="1 · confidence &lt; CONF_FLOOR 0.45  →  REJECT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=left;spacingLeft=10;" parent="rgates" vertex="1">
                    <mxGeometry x="20" y="80" width="720" height="34" as="geometry"/>
                </mxCell>
                <mxCell id="rg2" value="2 · nearest intent is  none  →  REJECT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=left;spacingLeft=10;" parent="rgates" vertex="1">
                    <mxGeometry x="20" y="120" width="720" height="34" as="geometry"/>
                </mxCell>
                <mxCell id="rg3" value="3 · no domain anchor (time | resource | participant | EVENT_NOUNS)  →  REJECT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=left;spacingLeft=10;" parent="rgates" vertex="1">
                    <mxGeometry x="20" y="160" width="720" height="34" as="geometry"/>
                </mxCell>
                <mxCell id="rg4" value="3b · resource anchor but no time AND no event noun  →  CLARIFY   (the parking case)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=left;spacingLeft=10;" parent="rgates" vertex="1">
                    <mxGeometry x="20" y="200" width="720" height="34" as="geometry"/>
                </mxCell>
                <mxCell id="rg5" value="4 · margin &lt; MARGIN_FLOOR 0.10  →  CLARIFY" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=left;spacingLeft=10;" parent="rgates" vertex="1">
                    <mxGeometry x="20" y="240" width="720" height="34" as="geometry"/>
                </mxCell>
                <mxCell id="rg6" value="5 · add_event | modify_event with no time anchor  →  CLARIFY   (what time?)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=left;spacingLeft=10;" parent="rgates" vertex="1">
                    <mxGeometry x="20" y="280" width="720" height="34" as="geometry"/>
                </mxCell>
                <mxCell id="ro1" value="PROCEED&#xa;34/105 · 32.4%&#xa;precision 100% on genuine" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" parent="r1" vertex="1">
                    <mxGeometry x="140" y="1450" width="240" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="ro2" value="CLARIFY&#xa;34/105 · 32.4%&#xa;ask a chip question" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" parent="r1" vertex="1">
                    <mxGeometry x="440" y="1450" width="240" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="ro3" value="REJECT&#xa;37/105 · 35.2%&#xa;precision 94.59%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" parent="r1" vertex="1">
                    <mxGeometry x="740" y="1450" width="240" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="rwarn" value="⚠ THE GATES ARE NOT OPTIONAL&#xa;raw classifier alone: 21.90% false-accept, 35.00% none recall&#xa;with gates:                    2.86% false-accept, 87.50% none recall&#xa;A port that stops after the kNN will pass happy-path tests and fail on real traffic." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;align=center;" parent="r1" vertex="1">
                    <mxGeometry x="140" y="1550" width="840" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="re1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" parent="r1" source="rin" target="rviews" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="re2" value="RAW text bypasses the views" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;strokeColor=#b85450;strokeWidth=2;exitX=1;exitY=0.5;entryX=1;entryY=0;" parent="r1" source="rin" target="rgates" edge="1">
                    <mxGeometry relative="1" as="geometry">
