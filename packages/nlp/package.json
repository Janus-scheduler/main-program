{
  "name": "@janus-scheduler/nlp",
  "version": "0.1.0",
  "type": "module",
  "description": "Frozen, zero-dependency intent classifier and entity extractor for Janus Scheduler",
  "main": "./dist/index.cjs",
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.es.js",
      "require": "./dist/node.cjs"
    },
    "./artifacts/*": "./artifacts/*"
  },
  "files": [
    "dist",
    "artifacts",
    "docs"
  ],
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "jest --coverage",
    "build": "vite build"
  },
  "keywords": [
    "nlp",
    "intent-classification",
    "static-embeddings",
    "zero-dependency"
  ],
  "author": "janus-scheduler-app",
  "license": "ISC",
  "sideEffects": false,
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.2.3",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4"
  },
  "dependencies": {
    "chrono-node": "^2.10.1"
  }
}
