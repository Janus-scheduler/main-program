{
  "name": "@janus-scheduler/nlp",
  "version": "2.1.0",
  "description": "Intent classifier and entity extractor powering Janus Scheduler's natural-language scheduling.",
  "keywords": [
    "nlp",
    "intent-classification",
    "entity-extraction",
    "static-embeddings",
    "scheduling"
  ],
  "license": "ISC",
  "author": "janus-scheduler-app",
  "homepage": "https://github.com/Janus-scheduler/main-program#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Janus-scheduler/main-program.git",
    "directory": "packages/nlp"
  },
  "bugs": {
    "url": "https://github.com/Janus-scheduler/main-program/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.es.js",
      "require": "./dist/node.cjs"
    },
    "./artifacts/*": "./artifacts/*"
  },
  "files": [
    "dist",
    "artifacts",
    "LICENSE",
    "README.md"
  ],
  "directories": {
    "test": "tests"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "npm run typecheck && jest --coverage",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.tests.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "chrono-node": "^2.10.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.2.3",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
