{
  "name": "@janus-scheduler/react",
  "version": "2.0.0",
  "description": "React components for Janus Scheduler — timeline, calendar grids and event editor with typed props and unwrapped event callbacks.",
  "keywords": [
    "scheduler",
    "calendar",
    "timeline",
    "events",
    "scheduling",
    "react",
    "react-component"
  ],
  "license": "ISC",
  "author": "janus-scheduler-app",
  "homepage": "https://github.com/Janus-scheduler/main-program#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Janus-scheduler/main-program.git",
    "directory": "packages/wrappers/react-wrapper"
  },
  "bugs": {
    "url": "https://github.com/Janus-scheduler/main-program/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/janus-scheduler-react.cjs",
  "module": "./dist/janus-scheduler-react.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/janus-scheduler-react.es.js",
      "require": "./dist/janus-scheduler-react.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "vite build",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@janus-scheduler/core": "^2.0.0",
    "@janus-scheduler/nlp": "^2.0.0",
    "@janus-scheduler/ui": "^2.0.0",
    "@lit/react": "^1.0.4"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
