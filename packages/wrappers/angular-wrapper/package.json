    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "npm run dev",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@angular/core": "^17.0.0 || ^18.0.0 || ^19.0.0 || ^20.0.0 || ^21.0.0"
  },
  "dependencies": {
    "@janus-scheduler/core": "^2.1.0",
    "@janus-scheduler/nlp": "^2.1.0",
    "@janus-scheduler/ui": "^2.1.0"
  },
  "devDependencies": {
    "@angular/core": "^21.1.0",
