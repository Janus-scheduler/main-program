{
  "name": "@janus-scheduler/angular",
  "version": "2.1.0",
  "description": "Angular components for Janus Scheduler — timeline, calendar grids and event editor.",
  "keywords": [
    "scheduler",
    "calendar",
    "timeline",
    "events",
    "scheduling",
    "angular",
    "angular-component"
  ],
  "license": "ISC",
  "author": "janus-scheduler-app",
  "homepage": "https://github.com/Janus-scheduler/main-program#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Janus-scheduler/main-program.git",
    "directory": "packages/wrappers/angular-wrapper"
  },
  "bugs": {
    "url": "https://github.com/Janus-scheduler/main-program/issues"
  },
  "type": "module",
  "sideEffects": false,
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
