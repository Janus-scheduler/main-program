{
  "name": "@janus-scheduler/integrations",
  "version": "2.1.0",
  "description": "Google Calendar two-way sync for Janus Scheduler — browser client plus an optional Express + WebSocket backend.",
  "keywords": [
    "scheduler",
    "calendar",
    "timeline",
    "events",
    "scheduling",
    "google-calendar",
    "sync",
    "oauth",
    "webhooks"
  ],
  "license": "ISC",
  "author": "janus-scheduler-app",
  "homepage": "https://github.com/Janus-scheduler/main-program#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Janus-scheduler/main-program.git",
    "directory": "packages/integrations"
  },
  "bugs": {
    "url": "https://github.com/Janus-scheduler/main-program/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/janus-scheduler-integrations.cjs",
  "module": "./dist/janus-scheduler-integrations.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/janus-scheduler-integrations.es.js",
      "require": "./dist/janus-scheduler-integrations.cjs"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.server.json",
    "dev": "vite build --watch",
    "test": "jest",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@janus-scheduler/core": "^2.1.0"
  },
  "dependencies": {
    "googleapis": "^128.0.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "node-cron": "^3.0.3",
    "ws": "^8.16.0",
    "uuid": "^9.0.0",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.11.0",
    "@types/node-cron": "^3.0.11",
    "@types/ws": "^8.5.10",
    "@types/uuid": "^9.0.7",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.3.3",
    "vite": "^5.1.0",
    "vite-plugin-dts": "^3.7.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
