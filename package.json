{
  "name": "janus-scheduler",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "packages/**",
    "demo/*"
  ],
  "scripts": {
    "dev:core": "npm run dev -w @janus-scheduler/core",
    "dev:react-demo": "npm run dev -w react-demo",
    "dev:angular-demo": "npm run dev -w angular-demo",
    "dev:solid-demo": "npm run dev -w solid-demo",
    "dev:vue-demo": "npm run dev -w vue-demo",
    "dev:integrations": "npm run dev -w @janus-scheduler/integrations",
    "build:integrations": "npm run build -w @janus-scheduler/integrations",
    "start:backend": "node --loader ts-node/esm packages/integrations/src/server/server.ts",
    "build:packages": "npm run build -w @janus-scheduler/core -w @janus-scheduler/nlp -w @janus-scheduler/ui",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test -w @janus-scheduler/core",
    "clean": "rimraf packages/core/dist packages/nlp/dist packages/ui/dist",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "prepare": "husky install",
    "format": "prettier \"**/*.{ts,tsx,js,json,md}\" --write",
    "validate": "npm run lint && npm run build --workspaces --if-present",
    "check:packages": "publint packages/core && publint packages/ui && publint packages/nlp && publint packages/integrations && publint packages/wrappers/react-wrapper && publint packages/wrappers/angular-wrapper && publint packages/wrappers/solid-js-wrapper && publint packages/app",
    "build:all": "npm run build --workspace=@janus-scheduler/core --workspace=@janus-scheduler/nlp --workspace=@janus-scheduler/ui --workspace=@janus-scheduler/react --workspace=@janus-scheduler/angular --workspace=@janus-scheduler/solid --workspace=@janus-scheduler/integrations --workspace=@janus-scheduler/app",
    "test:pack": "node scripts/smoke/run.mjs",
    "version-packages": "changeset version && npm install --package-lock-only",
    "release": "npm run build:all && node scripts/publish-packages.mjs",
    "release:publish": "node scripts/publish-packages.mjs",
    "release:dry": "node scripts/publish-packages.mjs --dry-run"
  },
  "devDependencies": {
    "@changesets/cli": "2.29.7",
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@eslint/js": "^10.0.1",
    "@rushstack/node-core-library": "^5.24.0",
    "@types/express-serve-static-core": "^5.1.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "alien-signals": "^3.2.1",
    "compare-versions": "^6.1.1",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "hermes-parser": "^0.37.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "local-pkg": "^1.2.1",
    "prettier": "^3.8.1",
    "publint": "0.3.14",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.56.0",
    "vscode-uri": "^3.1.0",
    "zod": "^4.4.3",
    "zod-validation-error": "^5.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
