{
  "name": "janus-scheduler",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "packages/**",
    "demo/*"
  ],
  "scripts": {
    "dev:core": "npm run dev -w @janus-scheduler/core",
    "dev:react-demo": "npm run dev -w react-demo",
    "dev:angular-demo": "npm run dev -w angular-demo",
    "dev:solid-demo": "npm run dev -w solid-demo",
    "dev:vue-demo": "npm run dev -w vue-demo",
    "build:packages": "npm run build -w @janus-scheduler/core -w @janus-scheduler/nlp -w @janus-scheduler/ui",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test -w @janus-scheduler/core",
    "clean": "node -e \"const fs=require('fs');['packages/core/dist','packages/nlp/dist','packages/ui/dist'].forEach(d=>fs.rm(d,{recursive:true,force:true},()=>{}))\"",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "prepare": "husky install",
    "format": "prettier \"**/*.{ts,tsx,js,json,md}\" --write",
    "validate": "npm run lint && npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "rimraf": "^6.1.3",
    "typescript": "^5.5.0",
    "vscode-uri": "^3.1.0",
    "zod": "^4.4.3",
    "zod-validation-error": "^5.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "typescript-eslint": "^8.56.0"
  }
}
